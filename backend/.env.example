# Server Port
PORT=3000

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_encryption_key_at_least_32_characters_long

# Firebase Service Account Secrets
# ⚠️ NEVER commit your actual .env or service account private key to Git!
# Provide credentials via environment variables:
FIREBASE_PROJECT_ID=visol-dating-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xyz@visol-dating-app.iam.gserviceaccount.com
# Note: Keep the quotes and replace newlines with \n if writing as a single line string:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# OR alternative local file path for development (ignored in .gitignore):
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
